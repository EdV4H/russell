{
  "name": "@edv4h/russell-plugin-model-claude",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "モデルプラグイン: Claude API（本番）。ANTHROPIC_API_KEY が要る。オフライン検証は model-echo を使う。",
