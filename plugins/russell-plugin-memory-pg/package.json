{
  "name": "@edv4h/russell-plugin-memory-pg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "記憶プラグイン（本番）: Postgres + pgvector。DATABASE_URL で接続。P0 は notes/books の最小実装。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@edv4h/russell-shared": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.0"
  }
}
