{
  "name": "@edv4h/russell-plugin-db-pg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Postgres の接続先と接続の作り方を1か所に持ち、pg を使うプラグインへ配る。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@edv4h/russell-shared": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@edv4h/russell-tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.0"
  }
}
