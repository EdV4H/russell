{
  "name": "@edv4h/russell-plugin-settings-pg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "運用設定（日報の投稿先など）を Postgres に持つ。env ではなく、変更が監査に残る場所へ。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@edv4h/russell-migrate": "workspace:*",
    "@edv4h/russell-shared": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.0"
  }
}
