{
  "name": "@edv4h/russell-plugin-surface-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "通信面プラグイン: CLI（stdin/stdout）。外部依存なしにコアと認知ループを検証できる（plugin-first の狙い）。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@edv4h/russell-shared": "workspace:*"
  },
  "devDependencies": {
    "@edv4h/russell-tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
