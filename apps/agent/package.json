{
  "name": "@edv4h/russell-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "組み立てホスト。プリセット→プラグイン配列→createAgent（usketch の apps/web 相当）",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=../../.env dist/main.js",
    "migrate": "node --env-file-if-exists=../../.env dist/migrate.js"
  },
  "dependencies": {
    "@edv4h/russell-core": "workspace:*",
    "@edv4h/russell-migrate": "workspace:*",
    "@edv4h/russell-plugin-audit-pg": "workspace:*",
    "@edv4h/russell-plugin-killswitch-pg": "workspace:*",
    "@edv4h/russell-plugin-memory-inmem": "workspace:*",
    "@edv4h/russell-plugin-memory-pg": "workspace:*",
    "@edv4h/russell-plugin-model-claude": "workspace:*",
    "@edv4h/russell-plugin-model-claude-code": "workspace:*",
    "@edv4h/russell-plugin-model-echo": "workspace:*",
    "@edv4h/russell-plugin-surface-cli": "workspace:*",
    "@edv4h/russell-plugin-surface-slack": "workspace:*",
    "@edv4h/russell-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "typescript": "^5.7.0"
  }
}
