{
  "name": "@edv4h/russell-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "worker プロセス（§2）。夜間コンソリデーション（§4）を実行する。本番は pg-boss cron で 03:00 JST に起動。",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "consolidate": "node --env-file-if-exists=../../.env dist/main.js",
    "forget-person": "node --env-file-if-exists=../../.env dist/forget-person.js",
    "recheck-sensitive": "node --env-file-if-exists=../../.env dist/recheck-sensitive.js",
    "merge-term": "node --env-file-if-exists=../../.env dist/merge-term.js",
    "detach-self": "node --env-file-if-exists=../../.env dist/detach-self.js",
    "google-auth": "node --env-file-if-exists=../../.env dist/google-auth.js",
    "dispatch": "node --env-file-if-exists=../../.env dist/dispatch.js",
    "archive-events": "node --env-file-if-exists=../../.env dist/archive-events.js"
  },
  "dependencies": {
    "@edv4h/russell-core": "workspace:*",
    "@edv4h/russell-migrate": "workspace:*",
    "@edv4h/russell-plugin-audit-pg": "workspace:*",
    "@edv4h/russell-plugin-killswitch-pg": "workspace:*",
    "@edv4h/russell-plugin-memory-pg": "workspace:*",
    "@edv4h/russell-plugin-model-claude": "workspace:*",
    "@edv4h/russell-plugin-model-claude-code": "workspace:*",
    "@edv4h/russell-plugin-routines-pg": "workspace:*",
    "@edv4h/russell-plugin-settings-pg": "workspace:*",
    "@edv4h/russell-plugin-surface-slack": "workspace:*",
    "@edv4h/russell-shared": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@edv4h/russell-tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.0"
  },
  "exports": {
    "./model": {
      "source": "./src/model.ts",
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    }
  }
}
