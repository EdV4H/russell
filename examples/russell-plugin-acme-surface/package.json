{
  "name": "@edv4h/russell-plugin-acme-surface",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "プラグインの最小テンプレート（surface の例）。外注/サードパーティはこれを雛形にする。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
