  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@edv4h/russell-shared": "workspace:*"
  },
  "devDependencies": {
    "@edv4h/russell-tsconfig": "workspace:*",
    "typescript": "^5.7.0"
  }
}
