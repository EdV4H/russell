# Russell 環境変数の雛形。実値はコミットしない（デプロイ先の Secret Manager で保管、B-2）。
# ローカルは `cp .env.example .env` して埋める。

# --- Claude API（本番/開発でキー分離, B-2 / §11） ---
ANTHROPIC_API_KEY=

# --- Slack（個体ごとに別アプリ, B-2）。個体1号 Bob 用 ---
SLACK_BOT_TOKEN=          # xoxb-...（最小スコープ: app_mentions:read/channels:history/im:history/chat:write/reactions:write）
SLACK_APP_TOKEN=          # xapp-...（Socket Mode 用, connections:write）

# --- Postgres（pgvector 有効, §11） ---
DATABASE_URL=postgres://russell:russell@localhost:5432/russell

# --- 実行モード（off | dryrun | live, §6.5） ---
RUSSELL_MODE=dryrun

# --- キルスイッチ（fail-closed の別経路, §12-7）。1 で全自発行動を即凍結。 ---
# ※ Secret Manager ではなく必ず env/シグナルで持つ（DB 障害時にも効かせるため）。
RUSSELL_KILL=0
