# Russell 環境変数の雛形。実値はコミットしない（デプロイ先の Secret Manager で保管、B-2）。
# ローカルは `cp .env.example .env` して埋める。`pnpm dev` / `pnpm migrate` /
# worker の `consolidate` が起動時に読む（Node の --env-file-if-exists）。

# --- Claude API（本番/開発でキー分離, B-2 / §11） ---
ANTHROPIC_API_KEY=

# --- Slack（個体ごとに別アプリ, B-2）。個体1号 Bob 用 ---
# 両方揃うと通信面が CLI から Slack に切り替わる。
SLACK_BOT_TOKEN=          # xoxb-...（最小スコープ: app_mentions:read/channels:history/im:history/chat:write/reactions:write/commands）
SLACK_APP_TOKEN=          # xapp-...（Socket Mode 用, connections:write）

# --- Postgres（pgvector 有効, §11） ---
DATABASE_URL=postgres://russell:russell@localhost:5432/russell

# --- 実行モード（off | dryrun | live, §6.5） ---
# ※ **まだ接続されていない。** コードは dryrun 固定で、しかも mode はどの判定にも使われていない
#    （dryrun でも実際に投稿する）。この値を変えても挙動は変わらない。
RUSSELL_MODE=dryrun

# --- キルスイッチ（§12-4 / §12-7。詳細は docs/reference/35-killswitch.md） ---
# レベル3（別経路）。1 で完全沈黙。DB を読まないので DB 障害時にも効く。
# ※ Secret Manager ではなく必ず env/シグナルで持つ。
RUSSELL_KILL=0
# `/russell start`（解除）を実行できる人。Slack user id のカンマ区切り。
# **未設定なら誰も解除できない**（設定漏れが「誰でも解除できる」に倒れないように）。
RUSSELL_KILL_OPERATORS=
# 発動・解除の記録を流すチャンネル ID（#russell-管理）。未設定なら流さない。
RUSSELL_ADMIN_CHANNEL=

# --- 開発用のモデル経路（docs/reference/36-model-providers.md） ---
# ANTHROPIC_API_KEY が無いとき、claude-code を明示すると手元の Claude Code CLI を使う。
# 本番では拒否される。既定のモデルは opus（sonnet にすると dev のループが速い）。
RUSSELL_MODEL=
RUSSELL_CLAUDE_CODE_MODEL=
